# Stripe runs in TEST MODE ONLY. The app refuses to start checkout with a live key (sk_live_...).
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Optional: a recurring test-mode Price for the Family plan. If unset, checkout uses $7.99/month inline pricing.
STRIPE_PRICE_ID=
# Secret used to sign the entitlement cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# Public base URL used for Stripe redirect URLs.
APP_URL=http://localhost:3000
# Local development only: shows an "Unlock (demo)" button that grants the Family plan without Stripe.
# Ignored when NODE_ENV=production.
ALLOW_DEMO_UNLOCK=false
# Local development only: every page and API treats you as a Pro member, no Stripe or cookie needed.
# Ignored when NODE_ENV=production (next build / next start).
DEV_PRO=false

# --- Parent sign-in with Google (optional) ---
# Sign-in switches on only when all four below are set; otherwise the app runs signed-out
# (children's progress stays on each device) and the sign-in button is hidden.
# Postgres connection string, e.g. a free Neon database, or a local one:
#   postgres://postgres:postgres@localhost:5432/mathbridge
# Tables are created automatically on first use.
DATABASE_URL=
# Secret that protects sign-in cookies. Generate one with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed anywhere except Vercel and npm run dev (e.g. npm start on your own server): the public base URL.
# AUTH_URL=https://your-domain.example
